{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.remote-property-watchdog.example/v0.1/event-batch.json",
  "title": "Event Batch v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "agent_id",
    "property_id",
    "first_sequence",
    "last_sequence",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "agent_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "property_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "first_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "material-event.schema.json"
      }
    }
  }
}
